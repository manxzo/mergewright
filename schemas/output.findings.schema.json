{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mergewright.dev/schemas/0.1/output/findings",
  "title": "MergeWright output: findings",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "suggestion": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "severity",
          "blocking",
          "file",
          "line",
          "title",
          "detail",
          "suggestion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "findings"
  ],
  "additionalProperties": false
}
