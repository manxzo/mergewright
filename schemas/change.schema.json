{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mergewright.dev/schemas/0.1/change",
  "title": "MergeWright change",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CHG-[0-9]+$"
    },
    "spec": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "by": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "accepted": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "rejected": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "spec",
    "status",
    "summary"
  ],
  "additionalProperties": false
}
